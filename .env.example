# EHTravel — environment configuration (copy to .env and fill in)
# .env is git-ignored. NEVER commit real tokens.

# ============================================================================
# Duffel API (flights + stays) — https://app.duffel.com → Developers → Access tokens
# ============================================================================
# Use a test token for development and a separately managed live token in production.
DUFFEL_API_TOKEN="replace-with-your-duffel-token"
DUFFEL_API_VERSION="v2"
DUFFEL_API_BASE_URL="https://api.duffel.com"

# ============================================================================
# GraphQL router / front end
# ============================================================================
GRAPHQL_ENDPOINT="http://localhost:4000/graphql"
ROUTER_PORT="4000"

# ============================================================================
# Multimodal assistant middleware
# ============================================================================
ASSISTANT_UPLOAD_ENDPOINT="http://localhost:4100/v1/uploads"
ASSISTANT_SERVICE_URL="http://localhost:4100"
ASSISTANT_PORT="4100"
ASSISTANT_ALLOWED_ORIGINS="http://localhost:3000,https://web-production-11001.up.railway.app"

# Use separate, random values in production. Never expose either value to the browser.
ASSISTANT_SERVICE_KEY="replace-with-a-random-router-to-service-key"
EHT_AUTH_SECRET="replace-with-a-random-development-jwt-secret"
# EHT_AUTH_ISSUER="https://identity.example.com/"
# EHT_AUTH_AUDIENCE="ehtravel"

# Multimodal model and transcription (server-side only).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"

# Temporary ownership adapter. Production should replace this JSON mapping with the booking
# database/identity integration described in specs/EHT-002-multimodal-travel-assistant-spec.md.
# Key format is <tenant_id>:<JWT sub>; values are Duffel order IDs or booking references.
ORDER_ACCESS_JSON='{"demo-tenant:demo-user":[{"id":"ord_example"}]}'

# ============================================================================
# SAFe harness (optional integrations — see src/safe-agentic-workflow/.env.template)
# ============================================================================
PROJECT_NAME="EHTravel"
TICKET_PREFIX="EHT"
PRIMARY_DEV_BRANCH="main"
# LINEAR_API_KEY="lin_api_..."
# GITHUB_TOKEN="github-token-from-your-secret-manager"
